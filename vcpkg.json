{
	"$schema": "https://raw.githubusercontent.com/microsoft/vcpkg/master/scripts/vcpkg.schema.json",
	"name": "skyrim-diagnostics",
	"version-semver": "0.1.0",
	"description": "Performance and crash diagnostics for Skyrim SE/AE/VR",
	"license": "GPL-3.0-or-later",
	"supports": "windows & x64",
	"builtin-baseline": "00c5775211f45cd08b37fce0484b4cb940e422ab",
	"dependencies": [
		{
			"name": "directxmath",
			"version>=": "2025-04-03"
		},
		{
			"name": "directxtk",
			"version>=": "2025-10-27"
		},
		{
			"name": "fmt",
			"version>=": "12.1.0"
		},
		{
			"name": "imgui",
			"features": [
				"dx11-binding"
			]
		},
		{
			"name": "rapidcsv",
			"version>=": "8.90"
		},
		{
			"name": "spdlog",
			"version>=": "1.16.0"
		}
	]
}
